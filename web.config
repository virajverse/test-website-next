<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- SSI: let IIS process includes inside .shtml files -->
    <handlers>
      <add name="SSI-shtml" path="*.shtml" verb="*"
           modules="ServerSideIncludeModule" resourceType="File" />
    </handlers>

    <rewrite>
      <rules>

        <!-- Never serve environment files from the public webroot -->
        <rule name="BlockEnvironmentFiles" stopProcessing="true">
          <match url="(^|/)\.env(\..*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 1. OLD indexed .html URLs -> clean URL (301, protects SEO) -->
        <rule name="RedirectHtmlToClean" stopProcessing="true">
          <match url="^(.*)\.html$" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\.html" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. .shtml typed directly -> clean URL (301, avoids duplicate URLs) -->
        <rule name="RedirectShtmlToClean" stopProcessing="true">
          <match url="^(.*)\.shtml$" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\.shtml" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3. Remove trailing slash (except real directories) -->
        <rule name="RemoveTrailingSlash" stopProcessing="true">
          <match url="^(.*)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Legacy blogdetail redirect to clean /blog/{slug} (301 Permanent) -->
        <rule name="RedirectOldBlogDetail" stopProcessing="true">
          <match url="^blogdetail$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(?:^|&amp;)slug=([^&amp;]+)" />
          </conditions>
          <action type="Redirect" url="/blog/{C:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- Server-side CMS proxy routes -->
        <rule name="CmsBlogDetailProxy" stopProcessing="true">
          <match url="^api/blogs/(.+)$" />
          <action type="Rewrite" url="api/blog-detail.php?slug={R:1}" appendQueryString="false" />
        </rule>

        <rule name="CmsBlogListProxy" stopProcessing="true">
          <match url="^api/blogs$" />
          <action type="Rewrite" url="api/blogs.php" />
        </rule>

        <rule name="CmsWebhookProxy" stopProcessing="true">
          <match url="^api/revalidate$" />
          <action type="Rewrite" url="api/revalidate.php" />
        </rule>

        <!-- 4. Clean Blog Post Slug Route: /blog/{slug} -> blogdetail.shtml?slug={slug} -->
        <rule name="BlogDetailCleanSlug" stopProcessing="true">
          <match url="^blog/([^/]+)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="blogdetail.shtml?slug={R:1}" appendQueryString="true" />
        </rule>

        <!-- 5. Clean URL -> internally serve the .shtml file -->
        <rule name="ServeShtmlFile" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.shtml" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.shtml" />
        </rule>

      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.shtml" />
      </files>
    </defaultDocument>


    <!-- ===== Performance: static caching (images/css/js/fonts cache 1 year) ===== -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <!-- ensure correct types -->
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".mp4" /><mimeMap fileExtension=".mp4" mimeType="video/mp4" />
    </staticContent>

    <!-- ===== Performance: gzip + brotli compression ===== -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="application/x-font-ttf" enabled="true" />
        <add mimeType="font/*" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
    </httpCompression>

  </system.webServer>
</configuration>
