# ==============================================================================
# DigifyNext Website - Vercel / Production Environment Variables
# ==============================================================================
# Add these keys in Vercel Dashboard:
# Project -> Settings -> Environment Variables

# Centralized CMS Backend API URL
CMS_API_URL=https://blogary.jupsoft.com
NEXT_PUBLIC_CMS_API_URL=https://blogary.jupsoft.com

# Website Identifier registered in CMS Database
CMS_WEBSITE_ID=site-growth
NEXT_PUBLIC_CMS_WEBSITE_ID=site-growth

# Tenant Live API Secret Key
CMS_TENANT_API_KEY=digi_live_sec_growth_8821ecde71a209
CMS_API_KEY=digi_live_sec_growth_8821ecde71a209
NEXT_PUBLIC_CMS_API_KEY=digi_live_sec_growth_8821ecde71a209

# Site Public Domain
SITE_DOMAIN=https://digifynext.com
NEXT_PUBLIC_SITE_DOMAIN=https://digifynext.com

# Default Language
DEFAULT_LANGUAGE=en
