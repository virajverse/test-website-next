# ==============================================================================
# DigifyNext Website - Vercel / Production Environment Variables
# ==============================================================================
# Add these keys in Vercel Dashboard:
# Project -> Settings -> Environment Variables

# Centralized CMS Backend API URL
CMS_API_URL=https://your-cms-backend-url.com
NEXT_PUBLIC_CMS_API_URL=https://your-cms-backend-url.com

# Website Identifier registered in CMS Database
CMS_WEBSITE_ID=your-website-id
NEXT_PUBLIC_CMS_WEBSITE_ID=your-website-id

# Tenant Live API Secret Key
CMS_TENANT_API_KEY=your_tenant_live_api_key_here
CMS_API_KEY=your_tenant_live_api_key_here
NEXT_PUBLIC_CMS_API_KEY=your_tenant_live_api_key_here

# Site Public Domain
SITE_DOMAIN=https://your-site-domain.com
NEXT_PUBLIC_SITE_DOMAIN=https://your-site-domain.com

# Default Language
DEFAULT_LANGUAGE=en
